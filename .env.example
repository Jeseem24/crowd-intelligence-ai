# ============================================================
# AEGIS CROWD INTELLIGENCE & DECISION SUPPORT PLATFORM
# Environment Configuration Template
# Copy this file to '.env' and provide your Groq API key.
# ============================================================

# Groq Cloud API Key (Get free key at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Active Primary Generative LLM Model
# Supported cascade: openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.8-27b
LLM_MODEL=openai/gpt-oss-120b

# Agent Reasoning Cycle Interval (seconds)
AGENT_CYCLE_SECONDS=15

# Executive Briefing Generation Interval (seconds)
BRIEFING_INTERVAL_SECONDS=60

# Local Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
