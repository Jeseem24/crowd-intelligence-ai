# Groq API Key (Sign up at console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# LLM Model identifier
LLM_MODEL=qwen/qwen3.8-27b

# Agent reasoning cycle interval (seconds)
AGENT_CYCLE_SECONDS=15

# Autonomous Briefing interval (seconds)
BRIEFING_INTERVAL_SECONDS=60

# Host and Port
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
